# Configure git to use HTTPS with token for GitHub repos
# This is set by the setup-git-auth.sh script, but we also set it here as fallback
# Vercel needs GITHUB_TOKEN environment variable set in project settings

# Force npm to use HTTPS for git dependencies
# This prevents npm from converting HTTPS URLs to SSH
git-tag-version=false

# Configure npm to use HTTPS for GitHub URLs
# This ensures npm uses HTTPS even when package-lock.json has git+https://
@{createnew}:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
